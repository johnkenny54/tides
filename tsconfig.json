{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "module": "nodenext",
    "newLine": "lf",
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": false,
    "strict": true,
    "types": ["vite/client"]
  },
  "exclude": ["public"]
}
